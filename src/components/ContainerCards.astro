---

<section>
  {
    arrayCards.map(
      ({ id, localImage, repo, title, webGithub, webRender, colors }) => {
        const [color1, color2] = colors;
        const img = baseUrl(localImage);
        return (
          <a
            href={repo}
            title={webRender}
            class='box'
            style={{ '--am-bg': `linear-gradient(45deg, ${color1}, ${color2})` }}
          >
            <b />
            <img src={localImage} alt={title} />
          </a>
        );
      }
    )
  }
</section>

<style>
  section {
    min-height: 100vh;
    display: grid;
    padding: 2.2vmax;
    gap: 2.2vmax;
    display: grid;
    place-items: center;
    place-content: center;
    grid-template-columns: repeat(auto-fit, minmax(17vmax, 1fr));

    .box {
      position: relative;
      width: 16.27vmax;
      height: 23.44vmax;
      border-radius: 1.3vmax;
      background-color: #eee;

      img {
        position: absolute;
        width: 80%;
        height: 86%;
        object-fit: cover;
        z-index: 3;
        object-position: center;
        border-radius: inherit;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
      }

      &::before,
      &::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: var(--am-bg);
      }

      &::before {
      }

      &::after {
        filter: blur(1vmax);
      }

      b {
        position: absolute;
        display: block;
        inset: 0.26vmax;
        border-radius: 1.04vmax;
        background-color: rgba(0, 0, 0, 0.7);
        z-index: 2;
      }
    }
  }
</style>
